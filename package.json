{
  "name": "minimessage-js",
  "version": "2.1.0",
  "description": "Reimplementation of MiniMessage and associated Adventure APIs in TypeScript",
  "main": "dist/minimessage.cjs.js",
  "module": "dist/minimessage.esm.js",
  "browser": "dist/minimessage.umd.js",
  "types": "types/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "types"
  ],
  "author": "wasabithumbs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WasabiThumb/minimessage-js.git"
  },
  "bugs": {
    "url": "https://github.com/WasabiThumb/minimessage-js/issues",
    "email": "wasabithumbs@gmail.com"
  },
  "scripts": {
    "build": "bun run --parallel build-types build-esm build-cjs build-umd",
    "build-esm": "bun build ./src/index.ts --root ./src --outdir ./dist --format esm --entry-naming \"[dir]/minimessage.esm.js\"",
    "build-cjs": "bun build ./src/index.ts --root ./src --outdir ./dist --format cjs --entry-naming \"[dir]/minimessage.cjs.js\"",
    "build-umd": "bun build ./src/browser.ts --root ./src --outdir ./dist --format cjs --entry-naming \"[dir]/minimessage.umd.js\"",
    "build-types": "tsc --build tsconfig.types.json",
    "prepare": "bun run build",
    "test": "bun test"
  },
  "keywords": [
    "minimessage",
    "minecraft",
    "adventure",
    "component",
    "html"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "linkedom": "^0.18.13",
    "typescript": "^6.0.3"
  }
}
