{
  "compilerOptions": {
    "types": [ "jest" ],
    "target": "esnext",
    "module": "esnext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "rootDir": "./"
  },
  "include": [ "src/**/*", "tests/**/*" ],
  "exclude": [
    "node_modules",
    "dist",
    "types"
  ]
}
